{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "ignoreTests": true,
            "matchPackageNames": [
                "/proxmox/"
            ]
        }
    ],
    "customManagers": [
        {
            "description": "deb versions as Docker build envars",
            "customType": "regex",
            "fileMatch": [
                "(^|/)Dockerfile$"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*repoUrl=(?<registryUrl>http:\\/\\/[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+suite=(?<suite>[^\\s]+)\\s+components=(?<components>[^\\s]+)\\nENV\\s+.*?_VERSION=(?<currentValue>[^\\s]+)"
            ],
            "registryUrlTemplate": "{{{registryUrl}}}?suite={{{suite}}}&components={{{components}}}&binaryArch=amd64",
            "datasourceTemplate": "deb"
        }
    ]
}
